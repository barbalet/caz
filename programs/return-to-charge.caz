; name: return-to-charge
; description: survival policy for selecting charger, solar, or junction recovery before charge reaches zero

    JP   loop

INCLUDE "survival.inc"

loop:
    CALL survival_check

    IN   A,(BATTERY)
    CP   224
    JP   NC,charged

    CP   96
    JP   C,critical

    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,seek_charger

    IN   A,(SOLAR_LEVEL)
    CP   120
    JP   NC,seek_solar

    JP   seek_charger

critical:
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,seek_junction

    IN   A,(SOLAR_LEVEL)
    CP   96
    JP   NC,seek_solar

    JP   seek_charger

seek_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,230
    OUT  (EYELID),A
    JP   loop

seek_solar:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,176
    OUT  (EYELID),A
    JP   loop

seek_junction:
    LD   A,NAV_JUNCTION
    OUT  (NAV_INTENT),A
    IN   A,(JUNCTION_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_SCRATCH
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,240
    OUT  (EYELID),A
    JP   loop

charged:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_NEUTRAL
    OUT  (EAR_POSE),A
    LD   A,TAIL_CURL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,128
    OUT  (EYELID),A
    JP   loop
