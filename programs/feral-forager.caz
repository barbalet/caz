; name: feral-forager
; description: standalone feral-cat routine that favors sunning, wire tapping, hiding, and cautious foraging

    JP   loop

loop:
    JP   feral_energy

after_feral_energy:
    IN   A,(DROPPED)
    CP   1
    JP   NC,recover

    IN   A,(BATTERY)
    CP   140
    JP   C,conserve

    IN   A,(EAR_PATTERN)
    CP   MACHINE
    JP   Z,hide

    IN   A,(EAR_VOLUME)
    CP   192
    JP   NC,hide

    IN   A,(EAR_PATTERN)
    CP   PREY
    JP   Z,stalk

    IN   A,(SOLAR_LEVEL)
    CP   160
    JP   NC,sun_sprawl

forage:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,104
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,184
    OUT  (EYELID),A
    JP   loop

stalk:
    IN   A,(BATTERY)
    CP   168
    JP   C,conserve
    LD   A,SKILL_CRAWL
    OUT  (SKILL),A
    LD   A,GAIT_CROUCH
    OUT  (GAIT),A
    LD   A,92
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_STILL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,232
    OUT  (EYELID),A
    JP   loop

sun_sprawl:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,84
    OUT  (EYELID),A
    JP   loop

conserve:
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   64
    JP   NC,go_solar
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,96
    OUT  (EYELID),A
    JP   loop

hide:
    LD   A,SKILL_STARTLE
    OUT  (SKILL),A
    LD   A,GAIT_RETREAT
    OUT  (GAIT),A
    LD   A,68
    OUT  (HEAD_YAW),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,246
    OUT  (EYELID),A
    CALL pause
    JP   loop

recover:
    LD   A,SKILL_RECOVER
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,228
    OUT  (EYELID),A
    CALL pause
    JP   loop

feral_energy:
    IN   A,(ENERGY_SOURCE)
    CP   ENERGY_JUNCTION
    JP   Z,keep_junction
    CP   ENERGY_SOLAR
    JP   Z,keep_solar
    CP   ENERGY_CHARGER
    JP   Z,keep_charger

    IN   A,(BATTERY)
    CP   96
    JP   C,route_energy

clear_nav:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    JP   after_feral_energy

keep_junction:
    IN   A,(BATTERY)
    CP   176
    JP   C,go_junction
    JP   clear_nav

keep_solar:
    IN   A,(BATTERY)
    CP   160
    JP   C,go_solar
    JP   clear_nav

keep_charger:
    IN   A,(BATTERY)
    CP   250
    JP   C,go_charger
    JP   clear_nav

route_energy:
    CP   72
    JP   C,emergency_energy

    IN   A,(STRATEGY_TENDENCY)
    CP   160
    JP   NC,feral_wider

    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,house_no_slot
    IN   A,(CHARGER_DISTANCE)
    CP   64
    JP   C,go_charger
    IN   A,(SOLAR_LEVEL)
    CP   48
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   48
    JP   C,go_junction
    JP   wait_charger

house_no_slot:
    IN   A,(SOLAR_LEVEL)
    CP   96
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,go_junction
    JP   wait_charger

feral_wider:
    IN   A,(JUNCTION_DISTANCE)
    CP   56
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   64
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger
    JP   fallback_solar

emergency_energy:
    IN   A,(NAV_STATUS)
    CP   NAV_BLOCKED
    JP   Z,blocked_energy

    IN   A,(JUNCTION_DISTANCE)
    CP   56
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   32
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger

blocked_energy:
    IN   A,(SOLAR_LEVEL)
    CP   24
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,blocked_no_charger
    IN   A,(CHARGER_DISTANCE)
    CP   64
    JP   C,go_charger

blocked_no_charger:
    IN   A,(JUNCTION_DISTANCE)
    CP   32
    JP   C,go_junction
    JP   wait_charger

wait_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,152
    OUT  (EYELID),A
    JP   feral_energy

fallback_solar:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,164
    OUT  (EYELID),A
    JP   feral_energy

go_solar:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,176
    OUT  (EYELID),A
    JP   feral_energy

go_junction:
    LD   A,NAV_JUNCTION
    OUT  (NAV_INTENT),A
    IN   A,(JUNCTION_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_SCRATCH
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,240
    OUT  (EYELID),A
    JP   feral_energy

go_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,226
    OUT  (EYELID),A
    JP   feral_energy

pause:
    LD   B,34
wait:
    DEC  B
    JP   NZ,wait
    RET
