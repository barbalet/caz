; name: energy-aware-hunter
; description: standalone hunter that only stalks and pounces when charge and recovery options are healthy

    JP   loop

loop:
    JP   hunter_energy

after_hunter_energy:
    IN   A,(DROPPED)
    CP   1
    JP   NC,recover

    IN   A,(EAR_VOLUME)
    CP   204
    JP   NC,startle

    IN   A,(BATTERY)
    CP   150
    JP   C,rest_watch

    IN   A,(TERRAIN)
    CP   4
    JP   NC,careful_ground

    IN   A,(EAR_PATTERN)
    CP   PREY
    JP   Z,prey

    IN   A,(EYE_MOTION)
    CP   150
    JP   NC,play_watch

prowl:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,184
    OUT  (EYELID),A
    JP   loop

prey:
    IN   A,(BATTERY)
    CP   180
    JP   C,stalk
    IN   A,(EYE_EDGE)
    CP   174
    JP   NC,pounce

stalk:
    LD   A,SKILL_CRAWL
    OUT  (SKILL),A
    LD   A,GAIT_CROUCH
    OUT  (GAIT),A
    LD   A,104
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_STILL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,230
    OUT  (EYELID),A
    JP   loop

pounce:
    LD   A,SKILL_POUNCE
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,174
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_TWITCH
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_CHIRRUP
    OUT  (VOCAL),A
    LD   A,252
    OUT  (EYELID),A
    CALL pause
    JP   loop

play_watch:
    IN   A,(BATTERY)
    CP   176
    JP   C,rest_watch
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,210
    OUT  (EYELID),A
    JP   loop

careful_ground:
    LD   A,SKILL_CRAWL
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,204
    OUT  (EYELID),A
    JP   loop

rest_watch:
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,102
    OUT  (EYELID),A
    JP   loop

startle:
    LD   A,SKILL_STARTLE
    OUT  (SKILL),A
    LD   A,GAIT_RETREAT
    OUT  (GAIT),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_BOTTLE
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,248
    OUT  (EYELID),A
    CALL pause
    JP   loop

recover:
    LD   A,SKILL_RECOVER
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,232
    OUT  (EYELID),A
    CALL pause
    JP   loop

hunter_energy:
    IN   A,(ENERGY_SOURCE)
    CP   ENERGY_CHARGER
    JP   Z,keep_charger
    CP   ENERGY_SOLAR
    JP   Z,keep_solar
    CP   ENERGY_JUNCTION
    JP   Z,keep_junction

    IN   A,(BATTERY)
    CP   96
    JP   C,route_energy

clear_nav:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    JP   after_hunter_energy

keep_charger:
    IN   A,(BATTERY)
    CP   250
    JP   C,go_charger
    JP   clear_nav

keep_solar:
    IN   A,(BATTERY)
    CP   160
    JP   C,go_solar
    JP   clear_nav

keep_junction:
    IN   A,(BATTERY)
    CP   176
    JP   C,go_junction
    JP   clear_nav

route_energy:
    CP   72
    JP   C,emergency_energy

    IN   A,(STRATEGY_TENDENCY)
    CP   160
    JP   NC,feral_choice

    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,no_charger_slot
    IN   A,(CHARGER_DISTANCE)
    CP   64
    JP   C,go_charger
    IN   A,(SOLAR_LEVEL)
    CP   48
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   48
    JP   C,go_junction
    JP   wait_charger

no_charger_slot:
    IN   A,(SOLAR_LEVEL)
    CP   96
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,go_junction
    JP   wait_charger

feral_choice:
    IN   A,(JUNCTION_DISTANCE)
    CP   56
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   72
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger
    IN   A,(JUNCTION_DISTANCE)
    CP   104
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   48
    JP   NC,go_solar
    JP   wait_charger

emergency_energy:
    IN   A,(NAV_STATUS)
    CP   NAV_BLOCKED
    JP   Z,blocked_energy

    IN   A,(JUNCTION_DISTANCE)
    CP   40
    JP   C,go_junction
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,emergency_no_charger
    IN   A,(CHARGER_DISTANCE)
    CP   48
    JP   C,go_charger

emergency_no_charger:
    IN   A,(SOLAR_LEVEL)
    CP   32
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   56
    JP   C,go_junction
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger
    JP   wait_charger

blocked_energy:
    IN   A,(SOLAR_LEVEL)
    CP   24
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,blocked_no_charger
    IN   A,(CHARGER_DISTANCE)
    CP   64
    JP   C,go_charger

blocked_no_charger:
    IN   A,(JUNCTION_DISTANCE)
    CP   32
    JP   C,go_junction
    JP   wait_charger

wait_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,152
    OUT  (EYELID),A
    JP   hunter_energy

go_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,230
    OUT  (EYELID),A
    JP   hunter_energy

go_solar:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,176
    OUT  (EYELID),A
    JP   hunter_energy

go_junction:
    LD   A,NAV_JUNCTION
    OUT  (NAV_INTENT),A
    IN   A,(JUNCTION_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_SCRATCH
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,240
    OUT  (EYELID),A
    JP   hunter_energy

pause:
    LD   B,26
wait:
    DEC  B
    JP   NZ,wait
    RET
