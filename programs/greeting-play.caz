; name: greeting-play
; description: sociable kitchen sketch for human greeting, playful motion, curiosity, and settling back down

    JP   loop

INCLUDE "survival.inc"

loop:
    CALL survival_check

    IN   A,(BATTERY)
    CP   62
    JP   C,rest

    IN   A,(EAR_VOLUME)
    CP   206
    JP   NC,startle

    IN   A,(EAR_PATTERN)
    CP   HUMAN
    JP   Z,greet

    IN   A,(EYE_MOTION)
    CP   176
    JP   NC,play

    IN   A,(EAR_PATTERN)
    CP   UNKNOWN
    JP   Z,curious

    IN   A,(EYE_EDGE)
    CP   150
    JP   NC,curious

settle:
    LD   A,SKILL_SIT
    OUT  (SKILL),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_CURL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,146
    OUT  (EYELID),A
    JP   loop

greet:
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MEOW
    OUT  (VOCAL),A
    LD   A,172
    OUT  (EYELID),A
    CALL pause
    JP   loop

play:
    LD   A,SKILL_POUNCE
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,180
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_TWITCH
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_CHIRRUP
    OUT  (VOCAL),A
    LD   A,236
    OUT  (EYELID),A
    CALL pause
    JP   loop

curious:
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,204
    OUT  (EYELID),A
    JP   loop

startle:
    LD   A,SKILL_STARTLE
    OUT  (SKILL),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_BOTTLE
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,248
    OUT  (EYELID),A
    CALL pause
    JP   loop

rest:
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,EAR_NEUTRAL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,64
    OUT  (EYELID),A
    CALL pause
    JP   loop

pause:
    LD   B,30
wait:
    DEC  B
    JP   NZ,wait
    RET
