; name: nap-watch
; description: low-energy parlour mode that dozes until motion, human speech, or a startling sound appears

    JP   loop

INCLUDE "survival.inc"

loop:
    CALL survival_check

    IN   A,(EAR_VOLUME)
    CP   210
    JP   NC,startle

    IN   A,(EYE_MOTION)
    CP   185
    JP   NC,open_eye

    IN   A,(EAR_PATTERN)
    CP   HUMAN
    JP   Z,greet

nap:
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_NEUTRAL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,58
    OUT  (EYELID),A
    JP   loop

open_eye:
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,160
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,180
    OUT  (EYELID),A
    JP   loop

startle:
    LD   A,GAIT_RETREAT
    OUT  (GAIT),A
    LD   A,92
    OUT  (HEAD_YAW),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_BOTTLE
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,248
    OUT  (EYELID),A
    JP   loop

greet:
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MEOW
    OUT  (VOCAL),A
    LD   A,164
    OUT  (EYELID),A
    JP   loop
