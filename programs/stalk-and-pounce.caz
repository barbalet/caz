; name: stalk-and-pounce
; description: hedgerow hunting sketch that crouches, stalks, pounces, and recovers from startled footing

loop:
    IN   A,(DROPPED)
    CP   1
    JP   NC,recover

    IN   A,(EAR_VOLUME)
    CP   202
    JP   NC,startle

    IN   A,(BATTERY)
    CP   64
    JP   C,rest

    IN   A,(TERRAIN)
    CP   4
    JP   NC,cautious_ground

    IN   A,(EAR_PATTERN)
    CP   PREY
    JP   Z,prey

    IN   A,(EYE_MOTION)
    CP   132
    JP   NC,curious

prowl:
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,178
    OUT  (EYELID),A
    JP   loop

prey:
    IN   A,(EYE_EDGE)
    CP   168
    JP   NC,pounce

stalk:
    LD   A,SKILL_CRAWL
    OUT  (SKILL),A
    LD   A,108
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_STILL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,226
    OUT  (EYELID),A
    JP   loop

pounce:
    LD   A,SKILL_POUNCE
    OUT  (SKILL),A
    LD   A,176
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_TWITCH
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_CHIRRUP
    OUT  (VOCAL),A
    LD   A,252
    OUT  (EYELID),A
    CALL pause
    JP   loop

cautious_ground:
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,SKILL_CRAWL
    OUT  (SKILL),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,198
    OUT  (EYELID),A
    JP   loop

curious:
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,206
    OUT  (EYELID),A
    JP   loop

startle:
    LD   A,SKILL_STARTLE
    OUT  (SKILL),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_BOTTLE
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,250
    OUT  (EYELID),A
    CALL pause
    JP   loop

recover:
    LD   A,SKILL_RECOVER
    OUT  (SKILL),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,232
    OUT  (EYELID),A
    CALL pause
    JP   loop

rest:
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,EAR_NEUTRAL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,70
    OUT  (EYELID),A
    CALL pause
    JP   loop

pause:
    LD   B,28
wait:
    DEC  B
    JP   NZ,wait
    RET
