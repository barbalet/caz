; name: farmyard-mouser
; description: rural mouser routine tuned for prey rustle, tractor noise, human calls, weather, and glare

loop:
    IN   A,(EAR_PATTERN)
    CP   MACHINE
    JP   Z,machine

    IN   A,(EAR_PATTERN)
    CP   PREY
    JP   Z,prey

    IN   A,(EAR_PATTERN)
    CP   HUMAN
    JP   Z,human

    IN   A,(EAR_PATTERN)
    CP   WEATHER
    JP   Z,weather

    IN   A,(EYE_LUMA)
    CP   222
    JP   NC,glare

patrol:
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,132
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,176
    OUT  (EYELID),A
    JP   loop

machine:
    LD   A,GAIT_RETREAT
    OUT  (GAIT),A
    LD   A,80
    OUT  (HEAD_YAW),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_BOTTLE
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,235
    OUT  (EYELID),A
    JP   loop

prey:
    IN   A,(EYE_EDGE)
    CP   168
    JP   NC,pounce

crouch:
    LD   A,GAIT_CROUCH
    OUT  (GAIT),A
    LD   A,108
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_STILL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,225
    OUT  (EYELID),A
    JP   loop

pounce:
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,168
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_TWITCH
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_CHIRRUP
    OUT  (VOCAL),A
    LD   A,252
    OUT  (EYELID),A
    JP   loop

human:
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,160
    OUT  (EYELID),A
    JP   loop

weather:
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_CURL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,118
    OUT  (EYELID),A
    JP   loop

glare:
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,96
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,90
    OUT  (EYELID),A
    JP   loop
