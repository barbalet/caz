; name: sunward-forager
; description: standalone-energy sun-aware forager that keeps walking unless charge recovery is explicitly needed

    JP   loop

loop:
    CALL energy_gate

    IN   A,(DROPPED)
    CP   1
    JP   NC,recover

    IN   A,(LIFTED)
    CP   1
    JP   NC,recover

    IN   A,(EAR_VOLUME)
    CP   218
    JP   NC,machine_arc

    IN   A,(EYE_EDGE)
    CP   176
    JP   NC,open_arc

    IN   A,(EAR_PATTERN)
    CP   HUMAN
    JP   Z,social_weave

    IN   A,(EAR_PATTERN)
    CP   PREY
    JP   Z,prey_line

    IN   A,(SOLAR_LEVEL)
    CP   176
    JP   NC,sun_stride

forage:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,132
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,184
    OUT  (EYELID),A
    JP   loop

sun_stride:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,124
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,74
    OUT  (EYELID),A
    JP   loop

prey_line:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    IN   A,(EAR_BEARING)
    CP   92
    JP   C,prey_left
    CP   164
    JP   NC,prey_right
    OUT  (HEAD_YAW),A
    JP   prey_finish

prey_left:
    LD   A,92
    OUT  (HEAD_YAW),A
    JP   prey_finish

prey_right:
    LD   A,164
    OUT  (HEAD_YAW),A

prey_finish:
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_STILL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,234
    OUT  (EYELID),A
    JP   loop

social_weave:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_SNIFF
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,152
    OUT  (HEAD_YAW),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_PURR
    OUT  (VOCAL),A
    LD   A,170
    OUT  (EYELID),A
    JP   loop

open_arc:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    CALL safe_charger_head
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_QUESTION
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_MRRP
    OUT  (VOCAL),A
    LD   A,204
    OUT  (EYELID),A
    JP   loop

machine_arc:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    LD   A,SKILL_STARTLE
    OUT  (SKILL),A
    LD   A,GAIT_RETREAT
    OUT  (GAIT),A
    LD   A,88
    OUT  (HEAD_YAW),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_LOW
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_HISS
    OUT  (VOCAL),A
    LD   A,242
    OUT  (EYELID),A
    CALL pause
    JP   loop

recover:
    LD   A,SKILL_RECOVER
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,EAR_FLAT
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,224
    OUT  (EYELID),A
    CALL pause
    JP   loop

safe_charger_head:
    IN   A,(CHARGER_BEARING)
    CP   96
    JP   C,safe_charger_left
    CP   160
    JP   NC,safe_charger_right
    OUT  (HEAD_YAW),A
    RET

safe_charger_left:
    LD   A,96
    OUT  (HEAD_YAW),A
    RET

safe_charger_right:
    LD   A,160
    OUT  (HEAD_YAW),A
    RET

energy_gate:
    IN   A,(ENERGY_SOURCE)
    CP   ENERGY_CHARGER
    JP   Z,keep_charger
    CP   ENERGY_SOLAR
    JP   Z,keep_solar
    CP   ENERGY_JUNCTION
    JP   Z,keep_junction

    IN   A,(BATTERY)
    CP   90
    JP   C,route_energy

clear_nav:
    LD   A,NAV_WANDER
    OUT  (NAV_INTENT),A
    RET

keep_charger:
    IN   A,(BATTERY)
    CP   250
    JP   C,go_charger
    JP   clear_nav

keep_solar:
    IN   A,(BATTERY)
    CP   112
    JP   C,go_solar
    JP   clear_nav

keep_junction:
    IN   A,(BATTERY)
    CP   150
    JP   C,go_junction
    JP   clear_nav

route_energy:
    CP   72
    JP   C,emergency_energy

    IN   A,(STRATEGY_TENDENCY)
    CP   160
    JP   NC,feral_route

house_route:
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   C,house_no_slot
    IN   A,(CHARGER_DISTANCE)
    CP   96
    JP   C,go_charger
    IN   A,(SOLAR_LEVEL)
    CP   96
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   64
    JP   C,go_junction
    JP   go_solar

house_no_slot:
    IN   A,(SOLAR_LEVEL)
    CP   64
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,go_junction
    JP   go_solar

feral_route:
    IN   A,(SOLAR_LEVEL)
    CP   96
    JP   NC,go_solar
    IN   A,(JUNCTION_DISTANCE)
    CP   72
    JP   C,go_junction
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger
    JP   go_solar

emergency_energy:
    IN   A,(JUNCTION_DISTANCE)
    CP   56
    JP   C,go_junction
    IN   A,(SOLAR_LEVEL)
    CP   32
    JP   NC,go_solar
    IN   A,(CHARGER_SLOTS)
    CP   1
    JP   NC,go_charger
    JP   go_solar

go_charger:
    LD   A,NAV_CHARGER
    OUT  (NAV_INTENT),A
    IN   A,(CHARGER_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_WALK
    OUT  (SKILL),A
    LD   A,GAIT_WALK
    OUT  (GAIT),A
    LD   A,EAR_SCAN
    OUT  (EAR_POSE),A
    LD   A,TAIL_FLAG
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,226
    OUT  (EYELID),A
    JP   energy_gate

go_solar:
    LD   A,NAV_SOLAR
    OUT  (NAV_INTENT),A
    LD   A,SKILL_REST
    OUT  (SKILL),A
    LD   A,GAIT_LOAF
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_SWIVEL
    OUT  (EAR_POSE),A
    LD   A,TAIL_WRAP
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,160
    OUT  (EYELID),A
    JP   energy_gate

go_junction:
    LD   A,NAV_JUNCTION
    OUT  (NAV_INTENT),A
    IN   A,(JUNCTION_BEARING)
    OUT  (HEAD_YAW),A
    LD   A,SKILL_SCRATCH
    OUT  (SKILL),A
    LD   A,GAIT_PAW_TEST
    OUT  (GAIT),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_LEVEL
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_SILENT
    OUT  (VOCAL),A
    LD   A,240
    OUT  (EYELID),A
    JP   energy_gate

pause:
    LD   B,18
wait:
    DEC  B
    JP   NZ,wait
    RET
