; name: skill-pounce
; description: symbolic skill and body-port fixture for pounce/reflex checks

    JP   setup

INCLUDE "survival.inc"

setup:
    CALL survival_check

    LD   A,0
    OUT  (JOINT_INDEX),A
    LD   A,144
    OUT  (JOINT_ANGLE),A
    LD   A,1
    OUT  (JOINT_COMMIT),A

    LD   A,0
    OUT  (POSE_FRAME_INDEX),A
    LD   A,144
    OUT  (POSE_FRAME_VALUE),A
    LD   A,1
    OUT  (POSE_FRAME_FLAGS),A
    LD   A,8
    OUT  (POSE_FRAME_TIME),A
    LD   A,1
    OUT  (POSE_FRAME_COMMIT),A

loop:
    CALL survival_check

    LD   A,SKILL_POUNCE
    OUT  (SKILL),A
    LD   A,GAIT_POUNCE
    OUT  (GAIT),A
    LD   A,128
    OUT  (HEAD_YAW),A
    LD   A,EAR_FORWARD
    OUT  (EAR_POSE),A
    LD   A,TAIL_TWITCH
    OUT  (TAIL_POSE),A
    LD   A,VOCAL_CHIRRUP
    OUT  (VOCAL),A
    LD   A,248
    OUT  (EYELID),A

    IN   A,(SKILL_STATUS)
    CP   SKILL_STATUS_REFLEX
    JP   Z,loop

    IN   A,(REFLEX_STATE)
    CP   REFLEX_CLEAR
    JP   loop
